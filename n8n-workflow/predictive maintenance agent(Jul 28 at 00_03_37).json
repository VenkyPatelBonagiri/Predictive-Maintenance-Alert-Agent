    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $input.item.json;\n\nlet rawText;\ntry {\n  rawText = raw.content[0].text;\n} catch (e) {\n  // Path doesn't exist — return the raw structure so we can see what it actually looks like\n  return { json: { debug_error: \"content[0].text path failed\", raw_structure: raw } };\n}\n\n// Strip markdown code fences if present (```json ... ``` or ``` ... ```)\nconst cleaned = rawText.replace(/```json\\s*/g, '').replace(/```\\s*/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    udi: null,\n    product_id: \"unknown\",\n    product_type: \"unknown\",\n    risk_level: \"unknown\",\n    risk_score: null,\n    explanation: \"Could not parse LLM response\",\n    recommended_action: \"Review manually\",\n    urgency: \"Unknown\",\n    debug_raw_text: rawText // temporary — so we can see exactly what Claude returned\n  };\n}\n\nreturn { json: parsed };"
      },
