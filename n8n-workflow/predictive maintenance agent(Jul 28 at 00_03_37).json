        "subject": "=🚨 High-Risk Failure Alert: {{ $json.product_id }} (UDI {{ $json.udi }})",
        "message": "=<h2 style=\"color:#c0392b;\">High-Risk Equipment Failure Alert</h2>\n\n<table style=\"border-collapse: collapse; width: 100%; max-width: 500px;\">\n  <tr>\n    <td style=\"padding:6px; font-weight:bold;\">Machine ID</td>\n    <td style=\"padding:6px;\">{{ $json.product_id }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:6px; font-weight:bold;\">UDI</td>\n    <td style=\"padding:6px;\">{{ $json.udi }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:6px; font-weight:bold;\">Product Type</td>\n    <td style=\"padding:6px;\">{{ $json.product_type }}</td>\n  </tr>\n  <tr>\n    <td style=\"padding:6px; font-weight:bold;\">Risk Level</td>\n    <td style=\"padding:6px;\">{{ $json.risk_level }} (score: {{ $json.risk_score }})</td>\n  </tr>\n  <tr>\n    <td style=\"padding:6px; font-weight:bold;\">Urgency</td>\n    <td style=\"padding:6px;\">{{ $json.urgency }}</td>\n  </tr>\n</table>\n\n<h3>Explanation</h3>\n<p>{{ $json.explanation }}</p>\n\n<h3>Recommended Action</h3>\n<p>{{ $json.recommended_action }}</p>\n\n<hr>\n<p style=\"font-size:12px; color:#888;\">Automated alert from Predictive Maintenance Agent — generated {{ $now.toFormat('yyyy-MM-dd HH:mm') }}</p>",
