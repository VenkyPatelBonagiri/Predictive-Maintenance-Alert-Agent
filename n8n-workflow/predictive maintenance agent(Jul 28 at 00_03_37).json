    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const asset = $input.item.json;\n\n// Derived features — computed once per asset since we only have a single snapshot, not history\nconst tempDeviation = Math.round((asset.engineTempC - 80) * 100) / 100; // 80°C = normal baseline\nconst isOverdueMaintenance = asset.daysSinceMaintenance > 90;\nconst faultSeverity = asset.faultCodes >= 4 ? 'severe' : asset.faultCodes >= 2 ? 'moderate' : 'none';\nconst isLowFuel = asset.fuelLevelPct < 15;\n\nreturn {\n  json: {\n    ...asset,\n    temp_deviation_c: tempDeviation,\n    is_overdue_maintenance: isOverdueMaintenance,\n    fault_severity: faultSeverity,\n    is_low_fuel: isLowFuel\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        0
      ],
      "id": "b4541d45-ddc9-4875-9f13-955349ad74ff",
      "name": "Preprocess Features"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const a = $input.item.json;\n\nlet score = 0;\nconst reasons = [];\n\n// Tool Wear Failure\nif (a.toolWearMin >= 200) {\n  score += 2;\n  reasons.push(`Tool wear at ${a.toolWearMin} min — approaching failure zone`);\n}\n\n// Heat Dissipation Failure\nconst tempDiff = a.processTempK - a.airTempK;\nif (tempDiff < 8.6 && a.rotationalSpeedRpm < 1380) {\n  score += 3;\n  reasons.push(`Low temp differential (${tempDiff.toFixed(1)}K) with low speed (${a.rotationalSpeedRpm} rpm) — poor heat dissipation`);\n}\n\n// Power Failure\nconst powerWatts = a.torqueNm * (a.rotationalSpeedRpm * 2 * Math.PI / 60);\nif (powerWatts < 3500 || powerWatts > 9000) {\n  score += 3;\n  reasons.push(`Power at ${powerWatts.toFixed(0)}W — outside safe operating range`);\n}\n\n// Overstrain Failure — threshold depends on product type\nconst osfThresholds = { L: 11000, M: 12000, H: 13000 };\nconst osfThreshold = osfThresholds[a.productType] || 12000;\nconst strainValue = a.toolWearMin * a.torqueNm;\nif (strainValue > osfThreshold) {\n  score += 3;\n  reasons.push(`Overstrain value ${strainValue.toFixed(0)} exceeds ${a.productType}-type threshold (${osfThreshold})`);\n}\n\nlet risk_level;\nif (score >= 6) risk_level = 'high';\nelse if (score >= 3) risk_level = 'medium';\nelse risk_level = 'low';\n\nreturn {\n  json: {\n    ...a,\n    power_watts: Math.round(powerWatts),\n    overstrain_value: Math.round(strainValue),\n    risk_score: score,\n    risk_level,\n    risk_reasons: reasons\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
